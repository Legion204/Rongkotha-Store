# Payload CMS Secret (generate a random string)
PAYLOAD_SECRET=your_payload_secret_key_here

# Database URI (Neon PostgreSQL)
# Example Neon Pooled URL: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URI=postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require

# Base URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Stripe (Optional for local testing / ready for live keys)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

